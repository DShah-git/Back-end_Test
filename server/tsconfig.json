{
	"compilerOptions": {
		"target": "ESNext",
		"module": "CommonJS",
		"baseUrl": ".",
		"paths": {
			"@/*": [
				"src/*"
			],
			"@shared/*": [
				"../shared/*"
			],
			"@generated/*": [
				"./generated/*"
			]
		},
		"moduleResolution": "Node",
		"outDir": "dist",
		"importsNotUsedAsValues": "remove",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"types": [
			"vitest/globals"
		]
	},
	"include": [
		"src/**/*",
		"../shared/**/*",
		"generated/**/*"
	],
	"exclude": [
		"node_modules"
	]
}